# Shopify Admin API credentials (choose one auth method)

# Option 1: Static access token (legacy custom apps)
SHOPIFY_ACCESS_TOKEN=shpat_your_token_here

# Option 2: Client credentials (Dev Dashboard apps, Jan 2026+)
# SHOPIFY_CLIENT_ID=your_client_id
# SHOPIFY_CLIENT_SECRET=your_client_secret

# Required
MYSHOPIFY_DOMAIN=your-store.myshopify.com

# Optional
SHOPIFY_API_VERSION=2026-01
LOG_LEVEL=info

# Redis persistence (optional — caches OAuth tokens across restarts)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=shopify-mcp:
REDIS_MAX_RETRIES=10
REDIS_CONNECT_TIMEOUT_MS=10000
